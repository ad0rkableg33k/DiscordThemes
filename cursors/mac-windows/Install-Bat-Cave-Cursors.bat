@echo off
title Bat Cave cursors
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText('%~f0'); $m='##PS'+'CODE##'; $i=$t.LastIndexOf($m); Invoke-Expression ($t.Substring($i+$m.Length))"
echo.
pause
exit /b
##PSCODE##
$ErrorActionPreference = 'Stop'
$scheme = 'Bat Cave'
$slug = 'Bat-Cave'
$data = @{
  'ptr64' = ''
  'ptr32' = ''
  'hov64' = ''
  'hov32' = ''
  'load64' = ''
  'load32' = ''
}
$key = 'HKCU:\Control Panel\Cursors'
$names = 'Arrow','Help','AppStarting','Wait','Crosshair','IBeam','NWPen','No','SizeNS','SizeWE','SizeNWSE','SizeNESW','SizeAll','UpArrow','Hand','Pin','Person'
Write-Host ''
Write-Host "  $scheme cursors"
Write-Host ''
Write-Host '  1  Install (normal size)'
Write-Host '  2  Install (small size, if normal looks too big)'
Write-Host '  3  Put the Windows default cursors back'
Write-Host ''
$c = Read-Host '  Type 1, 2 or 3 and press Enter'
try {
  Add-Type -Namespace W -Name N -MemberDefinition '[DllImport("user32.dll", SetLastError=true)] public static extern bool SystemParametersInfo(uint uiAction, uint uiParam, IntPtr pvParam, uint fWinIni);'
  if ($c -eq '3') {
    foreach ($n in $names) { Set-ItemProperty -Path $key -Name $n -Value '' }
    Set-ItemProperty -Path $key -Name '(default)' -Value ''
    New-ItemProperty -Path $key -Name 'Scheme Source' -Value 0 -PropertyType DWord -Force | Out-Null
    [void][W.N]::SystemParametersInfo(0x57, 0, [IntPtr]::Zero, 3)
    Write-Host ''
    Write-Host '  Done. Your cursors are back to the Windows default.'
  } elseif ($c -eq '1' -or $c -eq '2') {
    $sz = if ($c -eq '2') { '32' } else { '64' }
    $dir = Join-Path $env:LOCALAPPDATA ('DiscordThemeCursors\' + $slug)
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    $files = @{}
    foreach ($k in 'ptr','hov','load') {
      $p = Join-Path $dir ($k + $sz + '.cur')
      [IO.File]::WriteAllBytes($p, [Convert]::FromBase64String($data[$k + $sz]))
      $files[$k] = $p
    }
    $map = @{ Arrow='ptr'; Help='ptr'; AppStarting='load'; Wait='load'; Crosshair='ptr'; IBeam='ptr'; NWPen='ptr'; No='ptr'; SizeNS='ptr'; SizeWE='ptr'; SizeNWSE='ptr'; SizeNESW='ptr'; SizeAll='ptr'; UpArrow='ptr'; Hand='hov'; Pin='hov'; Person='hov' }
    foreach ($n in $names) { Set-ItemProperty -Path $key -Name $n -Value $files[$map[$n]] }
    $label = if ($sz -eq '32') { $scheme + ' (small)' } else { $scheme }
    Set-ItemProperty -Path $key -Name '(default)' -Value $label
    New-ItemProperty -Path $key -Name 'Scheme Source' -Value 1 -PropertyType DWord -Force | Out-Null
    if (-not (Test-Path ($key + '\Schemes'))) { New-Item -Path ($key + '\Schemes') | Out-Null }
    $list = (($names[0..14] | ForEach-Object { $files[$map[$_]] }) -join ',')
    Set-ItemProperty -Path ($key + '\Schemes') -Name $label -Value $list
    [void][W.N]::SystemParametersInfo(0x57, 0, [IntPtr]::Zero, 3)
    Write-Host ''
    Write-Host "  Done. $label is now your cursor."
    Write-Host '  To undo it, run this file again and choose 3.'
  } else {
    Write-Host '  No change made. Run it again and type 1, 2 or 3.'
  }
} catch {
  Write-Host ''
  Write-Host ('  Something went wrong: ' + $_.Exception.Message)
}
